{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atue-raffle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGIN": "https://rifa.atue.tech"
  },
  "routes": [{ "pattern": "api-raffle.atue.tech", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atue-raffle",
      "database_id": "e06a1e31-f658-4ad8-b379-3c45f7f4ac75",
      "migrations_dir": "migrations"
    }
  ]
}
